rules_version = '2';
// PROPOSED rules for Firebase project zapling-1492d (shared by Zapling and Snap & Swap).
// NOT deployed. See RULES_SETUP.md. Replace the whole rules text in the console with this.
service cloud.firestore {
  match /databases/{database}/documents {
    // Zapling (unchanged): each signed-in person can read/write only their own save.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Snap & Swap: same rule, including subcollections (meals split by month).
    match /snapswap_users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
